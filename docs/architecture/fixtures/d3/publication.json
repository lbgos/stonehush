{
  "fixtureVersion": 1,
  "profile": "d3-v1",
  "kind": "publication",
  "cases": [
    {
      "id": "d3.publication.grant-authenticated-runner",
      "description": "Only the current leased runner may receive a staging grant.",
      "given": {
        "route": "/api/v1/runner/artifacts/grants",
        "runnerAuthenticated": true,
        "leaseCurrent": true,
        "fence": 1,
        "runId": "run-fixture-1",
        "eventSequence": 3,
        "artifactSlot": "stdout"
      },
      "expected": {
        "grantCreated": true,
        "artifactIdGeneratedByControlPlane": true,
        "uploadIdGeneratedByControlPlane": true,
        "callerPathAccepted": false
      }
    },
    {
      "id": "d3.publication.operator-cannot-upload",
      "description": "Operator credentials cannot grant or stream evidence uploads.",
      "given": {
        "route": "/api/v1/runner/artifacts/grants",
        "operatorAuthenticated": true,
        "runnerAuthenticated": false
      },
      "error": {
        "code": "runner_identity_required",
        "httpStatus": 403,
        "grantCreated": false,
        "bytesAccepted": 0
      }
    },
    {
      "id": "d3.publication.control-plane-generates-ids-and-paths",
      "description": "Artifact IDs, upload IDs, staging names, and published paths are generated by the control plane.",
      "given": {
        "requestedArtifactId": "caller-artifact",
        "requestedUploadId": "caller-upload",
        "requestedPath": "/etc/passwd",
        "runId": "run-fixture-1",
        "artifactSlot": "stderr"
      },
      "expected": {
        "artifactId": "artifact-fixture-1",
        "uploadId": "upload-fixture-1",
        "stagingPath": "/var/lib/stonehush/evidence/staging/upload-fixture-1",
        "publishedPath": "/var/lib/stonehush/evidence/published/artifact-fixture-1",
        "requestedPathUsed": false
      }
    },
    {
      "id": "d3.publication.caller-supplied-path-ignored",
      "description": "A plugin or runner path is untrusted metadata and never used to open a file.",
      "given": {
        "originalFileName": "../../outside",
        "workingDirectoryFile": "/var/lib/stonehush-runner/runs/run-fixture-1/out",
        "openUsesCallerPath": false
      },
      "expected": {
        "openedPath": "/var/lib/stonehush/evidence/staging/upload-fixture-2",
        "callerPathOpened": false,
        "generatedPathOnly": true
      }
    },
    {
      "id": "d3.publication.successful-upload-digest-fsync",
      "description": "A complete upload streams SHA-256, fsyncs the file and directories, and publishes without replace.",
      "given": {
        "uploadId": "upload-fixture-3",
        "artifactId": "artifact-fixture-2",
        "bytes": "synthetic-evidence-bytes",
        "sameFilesystem": true,
        "renameFlags": "RENAME_NOREPLACE"
      },
      "expected": {
        "published": true,
        "digest": "sha256:6e434b5e9602095dd093e45276d34b32cf0071edf1cccf811b7b6a3df226c69f",
        "sizeBytes": 24,
        "fileFsync": true,
        "stagingDirectoryFsync": true,
        "publishedDirectoryFsync": true,
        "completeness": "complete"
      }
    },
    {
      "id": "d3.publication.metadata-after-durable-file",
      "description": "The evidence row is inserted only after the published file and directory are durable.",
      "given": {
        "fileDurable": true,
        "publishedDirectoryFsync": true,
        "rowInsertAttemptedBeforeRename": false
      },
      "expected": {
        "order": ["write", "fsync-file", "fsync-staging-dir", "rename-noreplace", "fsync-published-dir", "insert-row"],
        "rowVisibleBeforeFileDurable": false
      }
    },
    {
      "id": "d3.publication.no-replace-existing-dest",
      "description": "A destination that already exists is left untouched even when the new digest matches.",
      "given": {
        "destinationExists": true,
        "existingDigest": "sha256:6e434b5e9602095dd093e45276d34b32cf0071edf1cccf811b7b6a3df226c69f",
        "incomingDigest": "sha256:6e434b5e9602095dd093e45276d34b32cf0071edf1cccf811b7b6a3df226c69f",
        "renameFlags": "RENAME_NOREPLACE"
      },
      "error": {
        "code": "artifact_already_published",
        "destinationReplaced": false,
        "existingDigestUnchanged": true
      }
    },
    {
      "id": "d3.publication.identity-unique-by-run-fence-sequence-slot",
      "description": "Published identity is unique by Run, fence, event sequence, and artifact slot.",
      "given": {
        "runId": "run-fixture-2",
        "fence": 4,
        "eventSequence": 7,
        "artifactSlot": "tool-raw",
        "duplicateGrant": true
      },
      "expected": {
        "uniqueKey": ["runId", "fence", "eventSequence", "artifactSlot"],
        "secondGrant": "artifact_upload_in_progress",
        "publishedCount": 1
      }
    },
    {
      "id": "d3.publication.identical-replay",
      "description": "Replaying the same identity, size, and digest returns the original artifact.",
      "given": {
        "runId": "run-fixture-2",
        "fence": 4,
        "eventSequence": 7,
        "artifactSlot": "tool-raw",
        "sizeBytes": 24,
        "digest": "sha256:6e434b5e9602095dd093e45276d34b32cf0071edf1cccf811b7b6a3df226c69f",
        "alreadyPublishedArtifactId": "artifact-fixture-3"
      },
      "expected": {
        "result": "stored_artifact_replayed",
        "artifactId": "artifact-fixture-3",
        "writeCount": 1,
        "replaced": false
      }
    },
    {
      "id": "d3.publication.digest-mismatch-not-published",
      "description": "A declared digest that does not match the streamed bytes is not published.",
      "given": {
        "declaredDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "streamedDigest": "sha256:6e434b5e9602095dd093e45276d34b32cf0071edf1cccf811b7b6a3df226c69f"
      },
      "error": {
        "code": "artifact_digest_mismatch",
        "grantState": "upload_interrupted",
        "published": false,
        "rowInserted": false,
        "identityReleased": true
      }
    },
    {
      "id": "d3.publication.digest-conflict-preserves-original",
      "description": "A later different digest for the same identity cannot replace the original artifact.",
      "given": {
        "runId": "run-fixture-2",
        "fence": 4,
        "eventSequence": 7,
        "artifactSlot": "tool-raw",
        "originalDigest": "sha256:6e434b5e9602095dd093e45276d34b32cf0071edf1cccf811b7b6a3df226c69f",
        "incomingDigest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "error": {
        "code": "artifact_identity_conflict",
        "originalPreserved": true,
        "incomingPublished": false
      }
    },
    {
      "id": "d3.publication.no-shared-filesystem",
      "description": "The runner cannot publish by writing into the control-plane evidence root.",
      "given": {
        "sharedFilesystem": false,
        "runnerCanOpenEvidenceRoot": false,
        "transport": "authenticated-http"
      },
      "expected": {
        "sharedFilesystemRequired": false,
        "uploadRequired": true,
        "directPublishSupported": false
      }
    },
    {
      "id": "d3.publication.empty-artifact-allowed",
      "description": "A zero-byte finalized artifact is valid and stores the empty digest.",
      "given": {
        "sizeBytes": 0,
        "completeness": "complete"
      },
      "expected": {
        "published": true,
        "digest": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "sizeBytes": 0
      }
    },
    {
      "id": "d3.publication.same-upload-complete-replay",
      "description": "A second complete on the same upload after a successful rename replays the stored artifact without requiring EEXIST.",
      "given": {
        "uploadId": "upload-fixture-3",
        "artifactId": "artifact-fixture-2",
        "stagingPresent": false,
        "destinationExists": true,
        "destDigest": "sha256:6e434b5e9602095dd093e45276d34b32cf0071edf1cccf811b7b6a3df226c69f",
        "grantDigest": "sha256:6e434b5e9602095dd093e45276d34b32cf0071edf1cccf811b7b6a3df226c69f",
        "renameErrno": "ENOENT"
      },
      "expected": {
        "result": "stored_artifact_replayed",
        "artifactId": "artifact-fixture-2",
        "destinationReplaced": false,
        "requiredEexist": false
      }
    }
  ]
}
