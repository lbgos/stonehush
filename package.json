{
  "name": "stonehush",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "node scripts/run-workspace-script.mjs build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "check:docs": "node scripts/check-docs.mjs",
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "format:check": "node scripts/check-files.mjs format",
    "lint": "node scripts/check-files.mjs syntax && pnpm run check:docs",
    "test": "node --test scripts/*.test.mjs && node scripts/run-workspace-script.mjs test",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck"
  }
}
